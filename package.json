{
  "name": "sonagi-playgrounds",
  "version": "1.0.0",
  "description": "Sonagi Playgrounds - Code Execution Sandbox using Cloudflare Workers",
  "main": "src/index.ts",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "test:examples": "node scripts/check-examples.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindulle/sonagi-playgrounds.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mindulle/sonagi-playgrounds/issues"
  },
  "homepage": "https://github.com/mindulle/sonagi-playgrounds#readme",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.12.9"
  }
}
